# Persistent Node server (`next start`). Do not deploy this app serverless.
#
# ZORUNLU. En az 32 karakter. Tanımsızsa süreç durur; rastgele secret üretilmez
# (üretilseydi her `npm run dev` / restart imzayı değiştirir, herkes yeniden giriş yapardı).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Çerez Secure bayrağı. Varsayılan: yalnız production + HTTPS.
# HTTP (localhost, LAN IP, `next start` şifresiz) üzerinde 0 kalır — aksi halde tarayıcı çerezi reddeder.
# COOKIE_SECURE=0
# COOKIE_SECURE=1

# Set to 1 to include the simulated OTP in JSON (always on in development).
# OTP_ECHO=1

# WALLET_PENDING_WAIT_MS=60  (demo: bekleyen kazanç 60 sn sonra kullanılabilir)

# ALLOW_SELF_ORDER=1 (yalnız yerel test)

